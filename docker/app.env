APP_NAME=${APP_NAME:-Laravel}
APP_ENV=production
APP_DEBUG=false
APP_KEY=${APP_KEY:?Falta APP_KEY}
APP_PREVIOUS_KEYS=${APP_PREVIOUS_KEYS:-}
APP_URL=https://${APP_DOMAIN:?Falta APP_DOMAIN}
APP_DOMAIN=${APP_DOMAIN}
APP_RATE_LIMIT_PER_MINUTE=${APP_RATE_LIMIT_PER_MINUTE:-120}
BLOCKED_IPS=${BLOCKED_IPS:-}
TRUSTED_PROXY_HOST=nginx
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_WORKERS=${OCTANE_WORKERS:-2}
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=${DB_DATABASE:-laravel}
DB_USERNAME=${DB_USERNAME:-laravel}
DB_PASSWORD=${DB_PASSWORD:?Falta DB_PASSWORD}
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=${REDIS_PASSWORD:?Falta REDIS_PASSWORD}
REDIS_PREFIX=${COMPOSE_PROJECT_NAME:-laravel}_
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=resend
RESEND_KEY=${RESEND_KEY:?Falta RESEND_KEY}
MAIL_FROM_ADDRESS=${MAIL_FROM_ADDRESS:?Falta MAIL_FROM_ADDRESS}
MAIL_FROM_NAME=${APP_NAME:-Laravel}
FILAMENT_ADMIN_EMAIL=${FILAMENT_ADMIN_EMAIL:?Falta FILAMENT_ADMIN_EMAIL}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID:-}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET:-}
GOOGLE_REDIRECT_URI=https://${APP_DOMAIN}/auth/google/callback
