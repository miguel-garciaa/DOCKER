{
	auto_https off
	admin off
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 120s
		}
		max_header_size 32KB
		# Solo cloudflared puede aportar la IP publica del cliente.
		trusted_proxies static 172.30.91.2
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

http://:8000 {
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	route {
		# cloudflared conserva el alias app:8000 en la red edge.
		@untrusted not remote_ip 127.0.0.1 ::1 172.30.91.2
		respond @untrusted 403
		@wrong_host not host {$APP_DOMAIN}
		respond @wrong_host 421

		header {
			-Server
			-X-Powered-By
		}
		request_body {
			max_size 24MB
		}

		# Una sola conexion WebSocket persistente no debe saltar entre procesos web.
		@reverb path /app /app/*
		reverse_proxy @reverb reverb:8080

		# Docker DNS devuelve todas las replicas del servicio app.
		reverse_proxy {
			dynamic a web-backend 8000 {
				refresh 2s
				versions ipv4
			}
			lb_policy least_conn
			lb_try_duration 3s
			lb_try_interval 100ms
			fail_duration 10s
			max_fails 1
			unhealthy_status 502 503 504
			transport http {
				dial_timeout 2s
				response_header_timeout 60s
			}
		}
	}
}
