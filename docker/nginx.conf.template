resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

log_format private "$remote_addr $host $request_method $status $body_bytes_sent";

upstream laravel {
    zone laravel 64k;
    least_conn;
    server app-1:8000 resolve max_fails=3 fail_timeout=10s;
    server app-2:8000 resolve max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream prometheus_backend {
    zone prometheus_backend 32k;
    server prometheus:9090 resolve;
}

upstream app_1_metrics {
    zone app_1_metrics 32k;
    server app-1:8000 resolve;
}

upstream app_2_metrics {
    zone app_2_metrics 32k;
    server app-2:8000 resolve;
}

upstream cloudflared_metrics {
    zone cloudflared_metrics 32k;
    server cloudflared:2000 resolve;
}

server {
    listen 8000 default_server;
    server_name _;
    return 421;
}

server {
    listen 8000;
    server_name ${APP_DOMAIN};
    server_tokens off;
    client_max_body_size 24m;

    set_real_ip_from cloudflared;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive on;

    access_log /var/log/nginx/access.log private;

    if ($http_x_forwarded_proto != "https") {
        return 308 https://${APP_DOMAIN}$request_uri;
    }

    location ^~ /internal/ {
        return 404;
    }

    location / {
        proxy_pass http://laravel;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}

server {
    listen 8000;
    server_name ${METRICS_DOMAIN};
    server_tokens off;

    if ($http_x_forwarded_proto != "https") {
        return 403;
    }

    auth_basic "Prometheus";
    auth_basic_user_file /tmp/.htpasswd;

    location / {
        proxy_pass http://prometheus_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 2s;
        proxy_read_timeout 60s;

        add_header Cache-Control no-store always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}

server {
    listen 9101;
    server_name _;
    access_log off;

    location = /health {
        return 200 "ok\n";
    }

    location = /metrics {
        default_type "text/plain; version=0.0.4";
        return 200 "# TYPE nginx_up gauge\nnginx_up 1\n";
    }

    location = /app-1-metrics {
        proxy_set_header Host ${APP_DOMAIN};
        proxy_pass http://app_1_metrics/internal/metrics;
    }

    location = /app-2-metrics {
        proxy_set_header Host ${APP_DOMAIN};
        proxy_pass http://app_2_metrics/internal/metrics;
    }

    location = /cloudflared-metrics {
        proxy_pass http://cloudflared_metrics/metrics;
    }

    location / {
        return 404;
    }
}
