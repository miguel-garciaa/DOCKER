{
    auto_https off
    admin 127.0.0.1:2019
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            write 60s
            idle 120s
        }
        max_header_size 32KB
    }
    frankenphp {
        worker {
            file /app/public/frankenphp-worker.php
            {$CADDY_SERVER_WORKER_DIRECTIVE}
        }
    }
}

http://:8000 {
    # No guardar cookies, cabeceras ni query strings en los logs de acceso.
    log {
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
            }
        }
    }
    route {
        # Solo cloudflared y healthchecks locales.
        @untrusted not remote_ip 127.0.0.1 ::1 172.30.91.2
        respond @untrusted 403
        @wrong_host not host {$APP_DOMAIN}
        respond @wrong_host 421
        @hidden path_regexp hidden (^|/)\.
        respond @hidden 404
        # Impide ejecutar PHP subido; el rewrite al worker sucede despues.
        @script path_regexp script (?i)\.(php[0-9]?|phtml|phar)(/|$)
        respond @script 404
        header {
            -Server
            -X-Powered-By
            X-Content-Type-Options nosniff
            X-Frame-Options SAMEORIGIN
            Referrer-Policy strict-origin-when-cross-origin
        }
        request_body {
            max_size 24MB
        }
        root * /app/public
        encode zstd gzip
        php_server {
            index frankenphp-worker.php
            try_files {path} frankenphp-worker.php
            resolve_root_symlink
        }
    }
}
