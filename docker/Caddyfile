{
	auto_https off
	admin off
	metrics
	servers {
		trusted_proxies static {$CLOUDFLARED_IPS}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 120s
		}
		max_header_size 32KB
	}
}

http://:8000 {
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}
	route {
		header -Server
		@untrusted not remote_ip {$CLOUDFLARED_IPS}
		respond @untrusted 403
		@internal path /internal/*
		respond @internal 404
		@app host {$APP_DOMAIN}
		handle @app {
			@blocked client_ip {$BLOCKED_IPS:0.0.0.0/32}
			respond @blocked 403
			@insecure not header X-Forwarded-Proto https
			redir @insecure https://{$APP_DOMAIN}{uri} 308
			request_body {
				max_size 24MB
			}
			reverse_proxy app-1:8000 app-2:8000 {
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto https
				header_up -CF-Connecting-IP
				lb_policy least_conn
				health_uri /up
				health_headers {
					Host {$APP_DOMAIN}
				}
				health_interval 10s
				health_timeout 3s
				fail_duration 10s
				unhealthy_status 502 503 504
				transport http {
					dial_timeout 2s
					response_header_timeout 60s
				}
			}
		}
		@metrics host {$METRICS_DOMAIN}
		handle @metrics {
			route {
				# No redirigir Basic Auth recibido por HTTP.
				@insecure not header X-Forwarded-Proto https
				respond @insecure 403
				basic_auth bcrypt {
					{$METRICS_USERNAME} {$METRICS_PASSWORD_HASH}
				}
				header {
					-Server
					Cache-Control no-store
					Strict-Transport-Security "max-age=31536000"
				}
				reverse_proxy prometheus:9090
			}
		}
		respond 421
	}
}

# Solo redes Docker, sin ruta del tunel a este puerto.
http://:9101 {
	route {
		respond /health 200
		metrics /metrics
		handle /app-1-metrics {
			rewrite * /internal/metrics
			reverse_proxy app-1:8000
		}
		handle /app-2-metrics {
			rewrite * /internal/metrics
			reverse_proxy app-2:8000
		}
		handle /cloudflared-metrics {
			rewrite * /metrics
			reverse_proxy cloudflared:2000
		}
		respond 404
	}
}
