{
	auto_https off
	admin off
	metrics
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 120s
		}
		max_header_size 16KB
	}
}

http://:9090 {
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	route {
		# Prometheus puede consultar las metricas del propio proxy sin autenticacion.
		@prometheus_metrics {
			path /internal/metrics
			remote_ip 172.30.93.2
		}
		metrics @prometheus_metrics
		@blocked_internal path /internal/metrics
		respond @blocked_internal 404

		# Solo el conector del tunel puede alcanzar la API desde la red edge.
		@untrusted not remote_ip 172.30.91.2
		respond @untrusted 403
		@wrong_host not host {$PROMETHEUS_DOMAIN}
		respond @wrong_host 421

		header {
			-Server
			-X-Powered-By
			Cache-Control "no-store"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
		}
		basic_auth bcrypt {
			import prometheus-auth.caddy
		}
		reverse_proxy prometheus:9090
	}
}
