# deploy.sh genera .env si no existe. No copiar este ejemplo sin completar claves.
COMPOSE_PROJECT_NAME=laravel
# Presupuesto TOTAL compartido, no por contenedor. G = GiB (1024^3 bytes).
PROJECT_CPUS=4
PROJECT_MEMORY=8G
APP_NAME=Laravel
APP_DOMAIN=app.example.com
# Imagen construida previamente; usar digest inmutable del registry.
APP_IMAGE=ghcr.io/organizacion/aplicacion@sha256:REEMPLAZAR
APP_KEY=
OCTANE_WORKERS=2
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
POSTGRES_PASSWORD=
# Hexadecimal de al menos 32 caracteres. El script genera 64.
REDIS_PASSWORD=
RESEND_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com
TUNNEL_TOKEN=
# El primer deploy resuelve y guarda los digests de infraestructura.
# Distribuir compose.images.yml a otros VPS para usar exactamente las mismas imagenes.
POSTGRES_IMAGE=postgres:18-bookworm
REDIS_IMAGE=redis:8-bookworm
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
