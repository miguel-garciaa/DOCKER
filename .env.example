# deploy.sh genera .env si no existe. No copiar este ejemplo sin completar claves.
COMPOSE_PROJECT_NAME=laravel
# Presupuesto TOTAL compartido, no por contenedor. G = GiB (1024^3 bytes).
PROJECT_CPUS=4
PROJECT_MEMORY=6G
PROJECT_SWAP=1G
APP_NAME=Laravel
# Opcional: usa una release OCI y evita construir/clonar codigo en el VPS.
APP_IMAGE=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_DOMAIN=app.example.com
APP_KEY=
OCTANE_WORKERS=2
DB_DATABASE=database/database.sqlite
DB_USERNAME=laravel
DB_PASSWORD=
POSTGRES_PASSWORD=
# Hexadecimal de al menos 32 caracteres. El script genera 64.
REDIS_PASSWORD=
RESEND_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com
FILAMENT_ADMIN_EMAIL=admin@example.com
TUNNEL_TOKEN=

# Valores de desarrollo local. Compose los reemplaza dentro de los contenedores.
DB_CONNECTION=sqlite
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http
REVERB_APP_MAX_CONNECTIONS=500
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none
# El primer deploy resuelve y guarda los digests de infraestructura.
# Distribuir compose.images.yml a otros VPS para usar exactamente las mismas imagenes.
POSTGRES_IMAGE=postgres:18-bookworm
REDIS_IMAGE=redis:8-bookworm
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
