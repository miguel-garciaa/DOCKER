# Copiar a .env (root:root, 600); nunca ejecutar con source.
COMPOSE_PROJECT_NAME=laravel
PROJECT_CPUS=4
PROJECT_MEMORY=6G
PROJECT_SWAP=1G
APP_IMAGE=laravel-app:local
APP_NAME=Laravel
APP_DOMAIN=app.example.com
APP_KEY=
APP_PREVIOUS_KEYS=
APP_RATE_LIMIT_PER_MINUTE=120
BLOCKED_IPS=
OCTANE_WORKERS=2
DB_DATABASE=laravel
DB_USERNAME=laravel
# openssl rand -hex 32 para cada contraseña, por separado.
DB_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
RESEND_KEY=
MAIL_FROM_ADDRESS=no-reply@example.com
FILAMENT_ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TUNNEL_TOKEN=
METRICS_DOMAIN=metrics.example.com
METRICS_USERNAME=grafana
# Hash bcrypt entre comillas simples para conservar los $.
METRICS_PASSWORD_HASH=''
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
