# Copia este archivo a .env, completa los valores y ejecuta sudo ./deploy.sh
COMPOSE_PROJECT_NAME=laravel
APP_IMAGE=laravel-app:local
APP_NAME=Laravel
APP_DOMAIN=
echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_PREVIOUS_KEYS=
APP_RATE_LIMIT_PER_MINUTE=120
BLOCKED_IPS=
OCTANE_WORKERS=4
DB_DATABASE=laravel
DB_USERNAME=laravel
# Genera cada contraseña por separado con: openssl rand -hex 32
DB_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
RESEND_KEY=
MAIL_FROM_ADDRESS=no-reply@dominio
FILAMENT_ADMIN_EMAIL=admin@dominio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TUNNEL_TOKEN=
METRICS_DOMAIN=metrics.dominio
METRICS_USERNAME=grafana
# Generar con: htpasswd -nbB grafana 'CONTRASEÑA' | cut -d: -f2
# Mantener las comillas simples para conservar los signos $.
METRICS_PASSWORD_HASH=''
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=4GB
age-keygen -o ~/backup-age-key.txt
age-keygen -y ~/backup-age-key.txt
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
